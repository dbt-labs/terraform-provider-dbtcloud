vars: {
  d2-config: {
    layout-engine: elk
  }
}

*.style.font-size: 22
*.*.style.font-size: 22

title: |md
  # Connections & credentials
| {near: top-center}

version_note: "dbt Cloud Terraform provider resources · v1.12.5 · 2 of 4" {
  near: top-right
  style: {
    font-size: 14
    stroke: transparent
    fill: transparent
  }
}

direction: right

classes: {
  external: {
    style: {
      stroke-dash: 2
      stroke: "#888888"
      fill: "#EEEEEE"
    }
  }
}

project: "project (see Project & environment diagram)" {
  class: external
}
environment: "environment (see Project & environment diagram)" {
  class: external
}
service_token: "service_token (see Account & access diagram)" {
  class: external
}

global_connection: {
  style: {
    fill: "#ACE1AF"
    stroke: green
  }
}
oauth_configuration
privatelink_endpoint: privatelink_endpoint (data source)
connection_catalog_config
semantic_layer_credential_service_token_mapping

env_creds: Environment Credentials {
  grid-columns: 3
  athena_credential
  databricks_credential
  snowflake_credential
  bigquery_credential
  fabric_credential
  postgres_credential
  redshift_credential
  teradata_credential
  spark_credential
  starburst_credential
  synapse_credential
  salesforce_credential
}

semantic_layer: Semantic Layer Credentials {
  grid-columns: 3
  snowflake_semantic_layer_credential
  bigquery_semantic_layer_credential
  redshift_semantic_layer_credential
  databricks_semantic_layer_credential
  postgres_semantic_layer_credential
}

platform_metadata: Platform Metadata Credentials {
  snowflake_platform_metadata_credential
  databricks_platform_metadata_credential
}

environment -- global_connection
project -- env_creds: created in {
  style: {
    stroke-dash: 3
  }
}
environment -- env_creds: used by
global_connection -- privatelink_endpoint
global_connection -- oauth_configuration
global_connection -- connection_catalog_config
global_connection -- platform_metadata

project -- semantic_layer
project -- semantic_layer_credential_service_token_mapping
semantic_layer_credential_service_token_mapping -- semantic_layer
semantic_layer_credential_service_token_mapping -- service_token

(global_connection -- *)[*].style.stroke: green
(* -- global_connection)[*].style.stroke: green
